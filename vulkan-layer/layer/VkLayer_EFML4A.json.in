{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "VK_LAYER_EFML4A_model_replacer",
    "type": "GLOBAL",
    "library_path": "@EFML4A_LAYER_LIBRARY_PATH@",
    "api_version": "1.3.0",
    "implementation_version": "1",
    "description": "EFML4A model replacer (implicit layer skeleton for Arknights: Endfield mod loading)",
    "functions": {
      "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
    },
    "enable_environment": {
      "EFML4A_ENABLE": "1"
    },
    "disable_environment": {
      "EFML4A_DISABLE": "1"
    }
  }
}
